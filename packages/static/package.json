{
  "name": "@commit-atlas/static",
  "version": "0.1.0",
  "description": "Deterministic static GitHub portfolio generator for CommitAtlas.",
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "bin": {
    "commitatlas": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm --prefix ../core run build && npm --prefix ../github run build && npm --prefix ../svg run build",
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "node ../../scripts/build-package.mjs",
    "test": "npm run build && node --test tests/static.test.mjs",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@commit-atlas/core": "0.1.0",
    "@commit-atlas/github": "0.1.0",
    "@commit-atlas/svg": "0.1.0",
    "zod": "^4.4.3"
  }
}

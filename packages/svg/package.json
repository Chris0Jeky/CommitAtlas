{
  "name": "@commit-atlas/svg",
  "version": "0.1.0",
  "description": "Accessible, deterministic SVG cards for GitHub portfolio signals.",
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "node ../../scripts/build-package.mjs",
    "pretest": "npm --prefix ../core run build",
    "test": "npm run build && node --test tests/svg.test.mjs",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run"
  }
}

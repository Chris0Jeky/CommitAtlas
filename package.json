{
  "name": "commit-atlas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test:core": "vitest run --config packages/core/vitest.config.ts",
    "test:github": "tsx --test app/api/v1/health/route.test.ts lib/http.test.ts lib/github/client.test.ts lib/github/demo.test.ts lib/github/validation.test.ts lib/github/adapters.test.ts lib/portfolio.test.ts lib/svg-adapters.test.ts lib/svg-routes.test.ts",
    "test:studio": "tsx --test app/studio/studio-card-availability.test.ts app/studio/studio-markdown.test.ts app/studio/studio-messages.test.ts app/studio/studio-presentation.test.ts app/studio/studio-urls.test.ts",
    "test:svg": "npm --prefix packages/svg test",
    "test:static": "npm --prefix packages/static test",
    "build:core": "npm --prefix packages/core run build",
    "build:github": "npm --prefix packages/github run build",
    "build:static": "npm --prefix packages/static run build",
    "build:action": "npm run build:static && ncc build action/src/index.ts -o action/dist -m --no-cache",
    "pack:core": "npm --prefix packages/core run pack:dry-run",
    "pack:github": "npm --prefix packages/github run pack:dry-run",
    "pack:svg": "npm --prefix packages/svg run pack:dry-run",
    "pack:static": "npm --prefix packages/static run pack:dry-run",
    "test:packaging": "node --test tests/package-packaging.test.mjs",
    "test:action": "npm run build:action && node --test action/action.test.mjs && git diff --exit-code -- action/dist",
    "test:deploy-tooling": "node --test tests/deployed-origin.test.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/rendered-svg.test.mjs tests/discoverability.test.mjs",
    "lint": "eslint . --ignore-pattern \"**/dist/**\" --ignore-pattern .next --ignore-pattern \"**/.claude/**\"",
    "deploy": "node scripts/deploy.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:deploy-tooling && npm run test:core && npm run test:github && npm run test:studio && npm run test:svg && npm run test:static && npm run test:action && npm run test:packaging && npm test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@cloudflare/vite-plugin": "1.53.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vercel/ncc": "0.45.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  },
  "type": "module"
}

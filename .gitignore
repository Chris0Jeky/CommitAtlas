# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/packages/core/dist/
/packages/github/dist/
/packages/static/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo
/.idea

# agent worktrees and local agent state
/.claude/

# The seeded design canvas is a ~2 MiB build artifact: the editor payload with the artboards
# injected. The .dc.html files beside it are the actual source and re-seed it on demand.
/design_cards/*.html
!/design_cards/*.dc.html

+    const project: unknown = value[i];
+    if (!isRecord(project) || typeof project.repo !== 'string') return false;
+    const slug = project.repo.trim(), parts = slug.split('/');
+    if (parts.length !== 2 || !/^(?!-)(?!.*--)[A-Za-z0-9-]{1,39}(?<!-)$/u.test(parts[0]!) ||

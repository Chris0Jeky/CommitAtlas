{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Canonical Cloudflare Worker configuration. The Vite plugin reads this at
  // build time and emits a deploy-ready copy at dist/server/wrangler.json with
  // `main` and `assets.directory` rewritten to the built output.
  //
  // Deploy with `npm run deploy`, never a bare `wrangler deploy` on an unbuilt
  // checkout. After a build, Wrangler follows .wrangler/deploy/config.json to
  // the generated dist/server/wrangler.json, which carries the built entry and
  // the static assets. Without that build it would deploy THIS file as-is —
  // same Worker name, no assets — replacing a working deployment with one that
  // serves no client bundle.
  "name": "commit-atlas",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Public-only last-known-good responses survive transient anonymous GitHub
  // quota and deadline failures for up to seven days. Forks must create and
  // bind their own namespace; namespace IDs are account-specific.
  "kv_namespaces": [
    {
      "binding": "LAST_GOOD",
      "id": "496ffd2df9144ec0814c381a62d13dbf"
    }
  ],
  // CommitAtlas renders public GitHub data and needs no secrets to serve every
  // documented surface. GITHUB_TOKEN is optional and, when used, is installed
  // out of band with `wrangler secret put GITHUB_TOKEN` — never committed.
  //
  // If you are deploying a fork, set SITE_ORIGIN to your own origin:
  //
  //   "vars": { "SITE_ORIGIN": "https://commit-atlas.<your-subdomain>.workers.dev" }
  //
  // It is the canonical URL this deployment advertises — in rel=canonical, the sitemap, the
  // robots.txt Sitemap line, and the JSON-LD. Left unset it defaults to this project's own
  // origin, which means a fork would tell crawlers the canonical copy of its pages lives
  // somewhere else and quietly deindex itself. It is deliberately a var rather than something
  // read from the request Host: a canonical URL has to be stable, and a per-request one would
  // name whatever alias a visitor arrived on.
  "vars": {}
}
